{
  "name": "@ketapay/node",
  "version": "0.1.0-beta.4",
  "description": "Official Node.js library for the KetaPay escrow API",
  "license": "MIT",
  "keywords": [
    "ketapay",
    "escrow",
    "payments",
    "nigeria",
    "api",
    "sdk"
  ],
  "homepage": "https://github.com/KetaPay/ketapay-node#readme",
  "bugs": {
    "url": "https://github.com/KetaPay/ketapay-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KetaPay/ketapay-node.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "generate": "openapi-typescript spec/v1.yaml -o src/generated/openapi.ts --default-non-nullable false && prettier --write src/generated/openapi.ts",
    "sync-spec": "node scripts/sync-spec.mjs",
    "check:spec": "node scripts/check-spec.mjs",
    "check:drift": "node scripts/check-drift.mjs",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=github-actions --reporter=json --outputFile.json=reports/unit.json",
    "test:contract": "node scripts/contract-test.mjs",
    "test:contract:ci": "node scripts/contract-test.mjs --reporter=default --reporter=json --outputFile.json=reports/contract.json",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --passWithNoTests",
    "test:catalogue": "vitest run test/catalogue-coverage.test.ts",
    "test:report": "node scripts/test-summary.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "smoke:deno": "deno run --allow-read scripts/smoke-deno.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stoplight/prism-cli": "5.16.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
