{
  "name": "@ketapay/node",
  "version": "0.1.0",
  "description": "Official Node.js library for the KetaPay escrow API",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "openapi-typescript spec/v1.yaml -o src/generated/openapi.ts --default-non-nullable false && prettier --write src/generated/openapi.ts",
    "sync-spec": "node scripts/sync-spec.mjs",
    "check:drift": "npm run generate && git diff --exit-code -- src/generated",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:contract": "node scripts/contract-test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.12.0",
    "@types/node": "22.10.2",
    "openapi-typescript": "7.4.4",
    "prettier": "3.4.2",
    "tsup": "8.3.5",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
